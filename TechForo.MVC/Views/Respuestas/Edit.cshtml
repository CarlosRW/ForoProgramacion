@model TechForo.Models.Vista_de_modelos.RespuestaModel

@{
    ViewBag.Title = "Editar Respuesta";
}

<div class="editar-respuesta-contenedor">
    <div class="card editar-respuesta-card">
        <div class="card-body">
            <h2 class="form-titulo">Editar respuesta</h2>

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            @using (Html.BeginForm("Edit", "Respuestas", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.RespuestaID)
                @Html.HiddenFor(model => model.PreguntaID)
                @Html.HiddenFor(model => model.ImagenUrl)

                <div class="mb-3">
                    <label class="form-label">Respuesta</label>
                    @Html.TextAreaFor(model => model.Contenido, new { @class = "form-control", rows = 5, placeholder = "Edite el contenido de la respuesta." })
                </div>

                <div class="mb-3">
                    <label class="form-label">Bloque de código</label>
                    @Html.TextAreaFor(model => model.Codigo, new { @class = "form-control codigo-textarea", rows = 7, placeholder = "Edite o agregue código si es necesario." })
                </div>

                if (!string.IsNullOrEmpty(Model.ImagenUrl))
                {
                    <div class="mb-3">
                        <label class="form-label">Imagen actual</label><br />
                        <img src="@Model.ImagenUrl" class="img-thumbnail imagen-actual" />
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Cambiar imagen</label>
                    <input type="file" name="imagen" class="form-control" accept="image/*" />
                </div>

                <button type="submit" class="btn btn-primary">
                    Guardar cambios
                </button>

                @Html.ActionLink("Volver", "Details", "Preguntas", new { id = Model.PreguntaID }, new { @class = "btn btn-secondary ms-2" })
            }
        </div>
    </div>
</div>

<style>
    .editar-respuesta-contenedor {
        margin-top: 20px;
    }

    .editar-respuesta-card {
        background-color: #111827;
        border: 1px solid #334155;
        color: #e5e7eb;
        border-radius: 10px;
    }

    .form-titulo {
        color: #f8fafc;
        margin-bottom: 20px;
    }

    .codigo-textarea {
        font-family: Consolas, monospace;
    }

    .imagen-actual {
        max-width: 350px;
        max-height: 350px;
        object-fit: contain;
    }
</style>