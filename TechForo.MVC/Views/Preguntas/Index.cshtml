@model List<TechForo.Data.Entidades.Pregunta>
@{
    ViewBag.Title = "Preguntas";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0" style="color:var(--ds-text)">Preguntas</h2>
    @if (Request.IsAuthenticated)
    {
        @Html.ActionLink("+ Nueva pregunta", "Create", "Preguntas", null, new { @class = "btn btn-ds-primary" })
    }
</div>

@if (TempData["MensajeExito"] != null)
{<div class="ds-alert-success">@TempData["MensajeExito"]</div>}
@if (TempData["MensajeError"] != null)
{<div class="ds-alert-danger">@TempData["MensajeError"]</div>}

@using (Html.BeginForm("Index", "Preguntas", FormMethod.Get, new { @class = "ds-toolbar mb-4" }))
{
    <div class="ds-search">
        <input type="search" name="buscar" value="@ViewBag.Buscar"
               class="form-control" placeholder="Buscar por título, etiqueta o autor..." />
        <button type="submit" class="btn btn-ds-outline">Buscar</button>
    </div>
    <div class="text-muted-help">@Model.Count pregunta(s)</div>
}

@if (Model.Count == 0)
{
    <div class="ds-alert-info">No se encontraron preguntas.</div>
}
else
{
    <div class="ds-question-list">
        @foreach (var pregunta in Model)
        {
            <div class="ds-question-item">
                <div class="ds-question-stats @(pregunta.Resuelta ? "is-resuelta" : "")">
                    <strong>@pregunta.TotalRespuestas</strong>
                    <span>resp.</span>
                    <span style="margin-top:.2rem;font-size:.75rem">@pregunta.TotalVistas 👁</span>
                </div>
                <div class="ds-question-body">
                    <a class="ds-question-title"
                       href="@Url.Action("Details", "Preguntas", new { id = pregunta.PreguntaID })">
                        @pregunta.Titulo
                    </a>
                    <p class="ds-question-excerpt">@pregunta.Descripcion</p>
                    <div class="ds-question-meta">
                        <span class="ds-avatar ds-avatar-sm">
                            @(string.IsNullOrWhiteSpace(pregunta.UsuarioNombre) ? "?" : pregunta.UsuarioNombre.Substring(0,1).ToUpper())
                        </span>
                        <span>@pregunta.UsuarioNombre</span>
                        <span>·</span>
                        <span>@pregunta.FechaCreacion.ToString("dd MMM yyyy")</span>
                        @if (pregunta.Resuelta)
                        {
                            <span class="ds-badge-resuelta">✓ resuelta</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(pregunta.Etiquetas))
                        {
                            foreach (string etiqueta in pregunta.Etiquetas.Split(','))
                            {
                                <span class="ds-tag">@etiqueta.Trim()</span>
                            }
                        }
                        <span class="ms-auto d-flex gap-2">
                            @Html.ActionLink("Ver", "Details", "Preguntas", new { id = pregunta.PreguntaID }, new { @class = "btn btn-ds-outline btn-sm" })
                            @if (Session["UsuarioID"] != null && pregunta.UsuarioID == Convert.ToInt32(Session["UsuarioID"]))
                            {
                                @Html.ActionLink("Editar", "Edit", "Preguntas", new { id = pregunta.PreguntaID }, new { @class = "btn btn-ds-outline btn-sm" })
                                using (Html.BeginForm("Delete", "Preguntas", new { id = pregunta.PreguntaID }, FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-ds-danger btn-sm"
                                            onclick="return confirm('¿Eliminar esta pregunta?');">
                                        Eliminar
                                    </button>
                                }
                            }
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}