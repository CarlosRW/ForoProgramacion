@model TechForo.Models.Vista_de_modelos.PreguntaModel

@{
    ViewBag.Title = "Nueva Pregunta";
}

<h2>Nueva Pregunta</h2>

@using (Html.BeginForm("Create", "Preguntas", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="mb-3">
        @Html.LabelFor(model => model.Titulo, new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Titulo, new { @class = "form-control", placeholder = "Ejemplo: Error al conectar SQL Server con MVC" })
        @Html.ValidationMessageFor(model => model.Titulo, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Descripcion, new { @class = "form-label" })
        @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", rows = 6, placeholder = "Explicá cuál es la duda o el error que tenés." })
        @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Codigo, new { @class = "form-label" })
        @Html.TextAreaFor(model => model.Codigo, new { @class = "form-control", rows = 8, placeholder = "Pegá aquí el bloque de código relacionado con la pregunta." })
    </div>

    <div class="mb-3">
        <label class="form-label">Imagen del error o captura</label>
        <input type="file" name="imagen" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-primary">Publicar pregunta</button>
    @Html.ActionLink("Volver", "Index", "Preguntas", null, new { @class = "btn btn-secondary ms-2" })
}