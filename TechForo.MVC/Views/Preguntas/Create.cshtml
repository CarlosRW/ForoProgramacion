@model TechForo.Models.Vista_de_modelos.PreguntaModel
@{
    ViewBag.Title = "Nueva Pregunta";
}

<div class="d-flex align-items-center gap-3 mb-4">
    @Html.ActionLink("← Volver", "Index", "Preguntas", null, new { @class = "btn btn-ds-outline btn-sm" })
    <h2 class="mb-0" style="color:var(--ds-text)">Nueva pregunta</h2>
</div>

<div class="ds-form-section">
    @using (Html.BeginForm("Create", "Preguntas", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "ds-alert-danger" })

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.Titulo)
            @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control mt-1", placeholder = "Ej: Error al conectar SQL Server con MVC" })
            @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "text-danger small" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.Descripcion)
            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control mt-1", rows = 6, placeholder = "Describí bien el problema: qué intentás hacer, qué error te da, qué probaste." })
            @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger small" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.Codigo)
            @Html.TextAreaFor(m => m.Codigo, new { @class = "ds-code-textarea form-control mt-1", rows = 8, placeholder = "Pegá aquí el bloque de código relacionado (opcional)." })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.Etiquetas)
            @Html.TextBoxFor(m => m.Etiquetas, new { @class = "form-control mt-1", maxlength = "300", placeholder = "c#, sql-server, mvc (separadas por coma)" })
            <div class="ds-form-hint">Separalas con comas. Ej: c#, entity-framework, linq</div>
            @Html.ValidationMessageFor(m => m.Etiquetas, "", new { @class = "text-danger small" })
        </div>

        <div class="form-group mb-4">
            <label class="form-label">Imagen o captura del error (opcional)</label>
            <input type="file" name="imagen" class="form-control mt-1" accept="image/*" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-ds-primary">Publicar pregunta</button>
            @Html.ActionLink("Cancelar", "Index", "Preguntas", null, new { @class = "btn btn-ds-outline" })
        </div>
    }
</div>