@model TechForo.Models.Vista_de_modelos.PreguntaDetalleViewModel
@{
    ViewBag.Title = Model.Titulo;
}

@if (TempData["MensajeExito"] != null)
{<div class="ds-alert-success">@TempData["MensajeExito"]</div>}

<!-- Cabecera de la pregunta -->
<div class="ds-card mb-4">
    <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
        <h2 style="color:var(--ds-text);font-size:1.3rem;font-weight:700;margin:0">@Model.Titulo</h2>
        @if (Model.Resuelta)
        {
            <span class="ds-badge-resuelta" style="white-space:nowrap">✓ resuelta</span>
        }
    </div>

    <div class="ds-question-meta mb-3">
        <span class="ds-avatar ds-avatar-sm">
            @(string.IsNullOrWhiteSpace(Model.UsuarioNombre) ? "?" : Model.UsuarioNombre.Substring(0,1).ToUpper())
        </span>
        <span>@Model.UsuarioNombre</span>
        <span>·</span>
        <span>@Model.FechaCreacion.ToString("dd MMM yyyy, HH:mm")</span>
        <span>·</span>
        <span>@Model.TotalVistas vista(s)</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Etiquetas))
    {
        <div class="mb-3">
            @foreach (string etiqueta in Model.Etiquetas.Split(','))
            {
                <span class="ds-tag">@etiqueta.Trim()</span>
            }
        </div>
    }

    <p style="color:var(--ds-text);white-space:pre-wrap">@Model.Descripcion</p>

    @if (!string.IsNullOrEmpty(Model.Codigo))
    {
        <pre class="ds-code-block mt-3"><code>@Model.Codigo</code></pre>
    }

    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
    {
        <div class="text-center mt-3">
            <img src="@Model.ImagenUrl" class="ds-img-preview" />
        </div>
    }

    <div class="d-flex gap-2 mt-3">
        @Html.ActionLink("← Volver", "Index", "Preguntas", null, new { @class = "btn btn-ds-outline btn-sm" })
        @if (Session["UsuarioID"] != null && Model.UsuarioID == Convert.ToInt32(Session["UsuarioID"]))
        {
            @Html.ActionLink("Editar", "Edit", "Preguntas", new { id = Model.PreguntaID }, new { @class = "btn btn-ds-outline btn-sm" })
        }
    </div>
</div>

<!-- Respuestas  -->
<h4 style="color:var(--ds-text-muted);font-size:.85rem;text-transform:uppercase;letter-spacing:.06em" class="mb-3">
    @(Model.Respuestas?.Count ?? 0) respuesta(s)
</h4>

@if (Model.Respuestas == null || Model.Respuestas.Count == 0)
{
    <div class="ds-alert-info mb-4">Esta pregunta todavía no tiene respuestas. ¡Sé el primero!</div>
}
else
{
    foreach (var respuesta in Model.Respuestas)
    {
        <div class="ds-card mb-3">
            <div class="ds-question-meta mb-2">
                <span class="ds-avatar ds-avatar-sm">
                    @(string.IsNullOrWhiteSpace(respuesta.UsuarioNombre) ? "?" : respuesta.UsuarioNombre.Substring(0,1).ToUpper())
                </span>
                <span>@respuesta.UsuarioNombre</span>
                <span>·</span>
                <span>@respuesta.FechaCreacion.ToString("dd MMM yyyy, HH:mm")</span>
            </div>

            @if (!string.IsNullOrEmpty(respuesta.Contenido))
            {
                <p style="color:var(--ds-text);white-space:pre-wrap">@respuesta.Contenido</p>
            }

            @if (!string.IsNullOrEmpty(respuesta.Codigo))
            {
                <pre class="ds-code-block mt-2"><code>@respuesta.Codigo</code></pre>
            }

            @if (!string.IsNullOrEmpty(respuesta.ImagenUrl))
            {
                <div class="text-center mt-2">
                    <img src="@respuesta.ImagenUrl" class="ds-img-preview" />
                </div>
            }

            @if (Session["UsuarioID"] != null && respuesta.UsuarioID == Convert.ToInt32(Session["UsuarioID"]))
            {
                <div class="d-flex gap-2 mt-3">
                    @Html.ActionLink("Editar", "Edit", "Respuestas", new { id = respuesta.RespuestaID }, new { @class = "btn btn-ds-outline btn-sm" })
                    using (Html.BeginForm("Delete", "Respuestas", new { id = respuesta.RespuestaID }, FormMethod.Post, new { style = "display:inline;" }))
                    {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ds-danger btn-sm"
                            onclick="return confirm('¿Eliminar esta respuesta?');">
                        Eliminar
                    </button>
                    }
                </div>
            }
        </div>
    }
}

<!-- Formulario nueva respuesta -->
<div class="ds-card mt-4">
    <h5 style="color:var(--ds-text-muted);font-size:.8rem;text-transform:uppercase;letter-spacing:.06em" class="mb-3">
        Añadir respuesta
    </h5>

    @if (Request.IsAuthenticated)
    {
        if (TempData["ErrorRespuesta"] != null)
        {
            <div class="ds-alert-danger">@TempData["ErrorRespuesta"]</div>
        }

        using (Html.BeginForm("Create", "Respuestas", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="PreguntaID" value="@Model.PreguntaID" />

            <div class="mb-3">
                <label class="form-label" style="color:var(--ds-text);font-weight:600">Respuesta</label>
                <textarea name="Contenido" class="form-control" rows="5"
                          style="background:var(--ds-bg-canvas);border-color:var(--ds-border);color:var(--ds-text)"
                          placeholder="Escribí tu respuesta aquí..."></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" style="color:var(--ds-text);font-weight:600">Bloque de código (opcional)</label>
                <textarea name="Codigo" class="ds-code-textarea form-control" rows="6"
                          placeholder="Pegá aquí código si aplica..."></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" style="color:var(--ds-text);font-weight:600">Imagen o captura (opcional)</label>
                <input type="file" name="imagen" class="form-control"
                       style="background:var(--ds-bg-canvas);border-color:var(--ds-border);color:var(--ds-text)"
                       accept="image/*" />
            </div>
            <button type="submit" class="btn btn-ds-primary">Publicar respuesta</button>
        }
    }
    else
    {
        <p style="color:var(--ds-text-muted)">
            Debés iniciar sesión para responder.
            @Html.ActionLink("Iniciar sesión", "Login", "Account", null, new { @class = "btn btn-ds-primary btn-sm ms-2" })
        </p>
    }
</div>