<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - TechForum</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>


@{
    bool modoOscuro = false;

    if (Session["ModoOscuro"] != null)
    {
        modoOscuro = (bool)Session["ModoOscuro"];
    }

    string fuente = "font-medium";

    if (Session["TamanoFuente"] != null)
    {
        switch (Session["TamanoFuente"].ToString())
        {
            case "Pequeño":
                fuente = "font-small";
                break;

            case "Grande":
                fuente = "font-large";
                break;

            default:
                fuente = "font-medium";
                break;
        }
    }

    string idioma = "Español";

    if (Session["Idioma"] != null)
    {
        idioma = Session["Idioma"].ToString();
    }

    string textoInicio = idioma == "English" ? "Home" : "Inicio";
    string textoPreguntas = idioma == "English" ? "Questions" : "Preguntas";
    string textoPerfil = idioma == "English" ? "My profile" : "Mi perfil";
    string textoConfiguracion = idioma == "English" ? "Settings" : "Configuración";
    string textoCerrarSesion = idioma == "English" ? "Log out" : "Cerrar sesión";
    string textoIniciarSesion = idioma == "English" ? "Log in" : "Iniciar sesión";
    string textoRegistrarse = idioma == "English" ? "Register" : "Registrarse";
}

<body class="@(modoOscuro ? "dark-theme" : "light-theme") @fuente">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark ds-topbar">
        <div class="container ds-shell">
            @Html.ActionLink("</> TechForum", "Index", "Home", new { area = "" }, new { @class = "navbar-brand ds-brand" })

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>
                        @Html.ActionLink(textoInicio, "Index", "Home", new { area = "" }, new { @class = "nav-link" })
                    </li>

                    <li>
                        @Html.ActionLink(textoPreguntas, "Index", "Preguntas", new { area = "" }, new { @class = "nav-link" })
                    </li>
                </ul>

                <ul class="navbar-nav align-items-sm-center">
                    @if (Request.IsAuthenticated)
                    {
                        <li class="nav-item">
                            @Html.ActionLink(textoPerfil, "Perfil", "Account", new { area = "" }, new { @class = "nav-link ds-avatar-link" })
                        </li>
                        <li>
                            @Html.ActionLink(textoConfiguracion, "Index", "Configuracion", null, new { @class = "nav-link" })
                        </li>
                        <li>
                            @Html.ActionLink(textoCerrarSesion, "Logout", "Account", new { area = "" }, new { @class = "nav-link" })
                        </li>
                    }
                    else
                    {
                        <li>
                            @Html.ActionLink(textoIniciarSesion, "Login", "Account", new { area = "" }, new { @class = "nav-link" })
                        </li>

                        <li>
                            @Html.ActionLink(textoRegistrarse, "Register", "Account", new { area = "" }, new { @class = "nav-link" })
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container ds-shell body-content">
        @RenderBody()

        <footer class="ds-footer mt-4">
            <p>&copy; @DateTime.Now.Year - TechForum · Foro de discusión técnica</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>