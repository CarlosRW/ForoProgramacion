@model TechForo.Models.Vista_de_modelos.LoginModel
@{
    ViewBag.Title = "Iniciar sesión";
}

<div class="ds-auth-wrap">
    <div class="ds-auth-box">
        <h2></> TechForum</h2>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="ds-alert-success">@TempData["MensajeExito"]</div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "ds-alert-danger" })

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Correo)
                @Html.TextBoxFor(m => m.Correo, new { @class = "form-control mt-1" })
                @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger small" })
            </div>

            <div class="form-group mb-4">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "form-control mt-1" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
            </div>

            <button type="submit" class="btn btn-ds-primary w-100">Ingresar</button>
        }

        <p class="text-center text-muted-help mt-3">
            ¿No tenés cuenta? @Html.ActionLink("Registrate aquí", "Register", "Account")
        </p>
    </div>
</div>