@model TechForo.Models.Vista_de_modelos.RegistroModel
@{
    ViewBag.Title = "Crear cuenta";
}

<div class="ds-auth-wrap">
    <div class="ds-auth-box" style="max-width:420px">
        <h2></> Crear cuenta</h2>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "ds-alert-danger" })

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Nombre)
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control mt-1" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Correo)
                @Html.TextBoxFor(m => m.Correo, new { @class = "form-control mt-1" })
                @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger small" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "form-control mt-1" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
            </div>

            <div class="form-group mb-4">
                @Html.LabelFor(m => m.ConfirmPassword)
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control mt-1" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
            </div>

            <button type="submit" class="btn btn-ds-primary w-100">Crear cuenta</button>
        }

        <p class="text-center text-muted-help mt-3">
            ¿Ya tenés cuenta? @Html.ActionLink("Iniciar sesión", "Login", "Account")
        </p>
    </div>
</div>